# Copy to .env for local dev. Never commit the real .env — set these in Railway/Vercel for prod.

ENVIRONMENT=development
DATABASE_URL=sqlite:///./app.db

# Razorpay TEST MODE keys only (dashboard → Settings → API Keys, in Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Agent model. Any OpenAI-compatible endpoint works; default is Groq's free tier.
# Alternatives: Cerebras, OpenRouter, or Gemini's OpenAI-compatible endpoint.
LLM_PROVIDER=openai_compat
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Comma-separated allowed browser origins (lock to the deployed frontend in prod)
ALLOWED_ORIGIN=http://localhost:5173

# Shared secret guarding the demo-only failure-injection endpoint
DEMO_KEY=change-me

# Policy guardrails
POLICY_MAX_DISCOUNT_PCT=20
POLICY_APPROVAL_THRESHOLD_INR=3000
POLICY_MAX_TXN_VALUE_INR=5000
POLICY_MAX_SESSION_SPEND_INR=8000
POLICY_MAX_ITEMS_PER_ORDER=5
POLICY_MAX_TOOL_CALLS_PER_TURN=8
POLICY_MAX_CONSECUTIVE_TOOL_ERRORS=3
